{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Trigger": {
    "MaximumCanSpeedMetresPerSecond": 0.05,
    "MaximumEncoderSpeedMetresPerSecond": 0.05,
    "MaximumVibrationRmsMetresPerSecondSquared": 0.15,
    "MaximumAngularVelocityDegreesPerSecond": 0.5,
    "MinimumDistanceMetres": 12,
    "MaximumDistanceMetres": 30,
    "DebounceMilliseconds": 1000,
    "CooldownSeconds": 10,
    "RequestLifetimeMilliseconds": 2000,
    "PublishAttempts": 3,
    "PublishTimeoutMilliseconds": 500
  },
  "SmartMetrix": {
    "Messaging": {
      "Url": "nats://localhost:4222"
    }
  }
}
