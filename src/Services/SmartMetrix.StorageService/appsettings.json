{
  "Storage": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "smartmetrix",
    "SecretKey": "smartmetrix-dev-secret",
    "Bucket": "smartmetrix-artifacts",
    "Region": "us-east-1",
    "RetentionDays": 365,
    "IncompleteUploadRetentionDays": 1,
    "PresignedUrlLifetimeSeconds": 900
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
