{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Segmentation": {
    "Backend": "Deterministic",
    "StoneVisionBaseUrl": "http://127.0.0.1:5000",
    "StoneVisionTimeoutSeconds": 180,
    "Provider": "OnnxRuntime",
    "Precision": "FP16",
    "ModelPath": "models/rocks-v1.onnx",
    "ModelVersion": "rocks-v1",
    "InputWidth": 512,
    "InputHeight": 512,
    "TileOverlap": 64,
    "MinimumConfidence": 0.6,
    "StorageBaseUrl": "http://storage-service:8080"
  }
}
