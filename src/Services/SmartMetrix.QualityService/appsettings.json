      "night": {
        "Version": "night-1",
        "MinimumSharpness": 0.10,
        "MinimumExposure": 0.20,
        "MaximumSaturation": 0.20,
        "MinimumTexture": 0.05,
        "MaximumShadowFraction": 0.70,
        "MaximumLensContamination": 0.65,
        "MaximumTimestampSkewNanoseconds": 5000000
      }
    }
  }
}
