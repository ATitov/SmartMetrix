{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CloudSync": {
    "CloudBaseUrl": "http://cloud-api:8080",
    "QueuePath": "data/cloud-sync",
    "ChunkSizeBytes": 1048576,
    "BandwidthLimitBytesPerSecond": 4194304,
    "PollIntervalSeconds": 5,
    "MaxBackoffSeconds": 300,
    "DeleteArtifactsAfterAcknowledgement": true
  }
}
