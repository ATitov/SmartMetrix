# Copy to /etc/smartmetrix/edge.env, chmod 600, and replace every value.
POSTGRES_PASSWORD=replace-with-a-long-random-value
ConnectionStrings__SmartMetrix="Host=postgres;Database=smartmetrix;Username=smartmetrix;Password=replace-with-a-long-random-value"
MINIO_ROOT_USER=smartmetrix
MINIO_ROOT_PASSWORD=replace-with-a-long-random-value
Storage__SecretKey=replace-with-the-same-minio-password
OperatorApi__ApiKeys__operator=replace-with-a-long-random-value
OperatorApi__BootstrapAdminPassword=replace-with-a-separate-long-random-password
CAMERA_A_SERIAL=replace-with-camera-a-serial
CAMERA_B_SERIAL=replace-with-camera-b-serial
CAMERA_C_SERIAL=replace-with-camera-c-serial
CAMERA_TRIGGER_SOURCE=Line0
CAMERA_TRIGGER_ACTIVATION=RisingEdge
CAMERA_PIXEL_FORMAT=Mono8
DEPTH_BACKEND=Native
DEPTH_NATIVE_PROVIDER=OpenCvCuda
